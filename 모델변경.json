                "fix": "catmull_clark subdivision level 2 이상 + max_influences 8로 설정"
            },
            {
                "symptom": "피부가 플라스틱/홀로그램처럼 보임",
                "cause": "SSS 없음 + 균일한 roughness 단색 base_color",
                "fix": "subsurface_weight 0.85 설정 + roughness 텍스처 맵 사용"
            },
            {
                "symptom": "몸 전체가 같은 재질감으로 보임",
                "cause": "부위별 roughness 변화 없음",
                "fix": "per_region roughness 맵 적용 (코끝 0.25, 이마 0.55 등)"
            },
            {
                "symptom": "빛을 받아도 입체감이 없음",
                "cause": "cavity/AO 맵 없음, normal map 없음",
                "fix": "skin_cavity_4k.png + skin_detail_normal_8k.exr 필수 적용"
            },
            {
                "symptom": "로즈골드 관절이 주황색 플라스틱처럼 보임",
                "cause": "metallic 1.0인데 anisotropy 없음 + 너무 균일한 roughness",
                "fix": "anisotropy 0.4 + machined scratch normal map 추가"
            },
            {
                "symptom": "전체 톤이 홀로그램/게임 그래픽처럼 보임",
                "cause": "emissive 과다 + bloom 과다 + SSS 없음의 복합 원인",
                "fix": "bloom threshold 0.9으로 높이고 emissive는 보석/광섬유에만 제한"
            }
        ]
    },
